  <vector id="guw" type="uint32" count="16"/>
  <vector id="gw" type="int32" count="16"/>
  <vector id="guh" type="uint16" count="32"/>
  <vector id="gh" type="int16" count="32"/>
  <vector id="gub" type="uint8" count="64"/>
  <vector id="gb" type="int8" count="64"/>
  <union id="gggx_vec">
    <field name="ud" type="gud"/>
    <field name="d" type="gd"/>
    <field name="uw" type="guw"/>
