    <field name="h" type="gh"/>
    <field name="ub" type="gub"/>
    <field name="b" type="gb"/>
  </union>

  <reg name="ggg0"  bitsize="512" offset="256"  encoding="vector" format="hex" group="GGGX Vector Registers" dwarf_regnum="200"/>
